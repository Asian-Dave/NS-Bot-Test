# virtualenv (149 MB; recreate with: python3 -m venv .venv && .venv/bin/pip install -r requirements.txt)
.venv/

# runtime state. Contains the Chrome profile with a LIVE SESSION COOKIE, plus
# logs and control files. Must never be committed.
run/

# third-party product binaries - not ours to redistribute
*.exe

__pycache__/
*.py[cod]
.DS_Store

# Reference material from a third-party commercial product (its config format,
# UI screenshot and installer). Kept locally for design reference only - not
# ours to redistribute. Remove these lines if you want them in a private repo.
BotSettings.json
Configs/
settings.png

# Decompiled third-party bot, kept locally as mechanics reference only (~7 MB:
# 61 C# files, 10 DLLs, the extracted binary). Read, never built, never imported.
# Excluded deliberately - whether a third party's decompiled binary belongs in
# this history is a call for the repo owner, not a default. docs/PORT_FROM_CMMHERO.md
# records everything taken from it, so the port is reviewable without it.
ref/tp/

# Automated capture dumps (281 MB and growing). These are the bot's own working
# screenshots - every state probe, every calibration burst, every live run. They
# are scratch, not source: regenerate them by running the engine.
#
# The handful of frames the test suite and the template-minting scripts assert
# against ARE committed, force-added past this rule, and listed in
# tests/test_battle_stack.py. ref/auto/tp/faces/ in particular is the twenty-crop
# memory-board fixture whose true pairing the match-gate test depends on; live
# runs write to ref/auto/tp/faces_live/ so they cannot overwrite it.
ref/auto/
ref/swf_assets/
